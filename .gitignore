# ─────────────────────────────────────────────────────────────
#  Runtime state — MUST NEVER be committed
#
#  These are created at runtime in CLAUDE_PLUGIN_DATA, but are
#  listed here in case anyone points that variable at the repo
#  while testing. Committing them would leak the HMAC key and a
#  record of every detection.
#
#  Note these do NOT match the committed templates
#  default-secrets.txt / default-policy.json.
# ─────────────────────────────────────────────────────────────
secrets.txt
policy.json
audit.jsonl
salt
errors.log
.piiguard/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ── Editors / OS ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ── Claude Code local settings ───────────────────────────────
#  Machine-specific permissions; not meant to be shared.
.claude/settings.local.json

# ── Scratch ──────────────────────────────────────────────────
*.log
*.tmp
tmp/
scratch/
